# Staged by scripts/apply.sh as browser/branding/goat/distribution/.
# Installs Goat's enterprise policies and bundled add-ons into
# dist/bin/distribution/, which the installer's package-manifest already
# ships (@RESPATH@/distribution/*).

DIST_SUBDIR = ""

FINAL_TARGET_FILES.distribution += [
    "policies.json",
]

FINAL_TARGET_FILES.distribution.extensions += [
    "extensions/uBlock0@raymondhill.net.xpi",
]
